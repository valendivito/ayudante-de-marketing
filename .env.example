# Requerida: usada para analizar los frames + transcripción de cada video con Claude.
ANTHROPIC_API_KEY=

# Opcional. Modelo de Claude a usar para el análisis. Default: claude-sonnet-4-6
ANTHROPIC_MODEL=

# Opcionales: transcripción por Whisper cuando el video no trae subtítulos
# (uploads, o URLs sin captions/auto-captions). Si no se define ninguna,
# el análisis sigue funcionando pero sin transcripción.
GROQ_API_KEY=
OPENAI_API_KEY=

# Opcionales: rutas de almacenamiento local. Por default cuelgan de ./storage
# DATABASE_PATH=./storage/db.sqlite
# WORK_DIR=./storage/frames
# UPLOAD_DIR=./storage/uploads
