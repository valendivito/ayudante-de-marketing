# Requerida: usada para analizar los frames + transcripción de cada video con Claude.
ANTHROPIC_API_KEY=

# Opcional. Modelo de Claude a usar para el análisis. Default: claude-sonnet-4-6
ANTHROPIC_MODEL=

# Opcionales: transcripción por Whisper cuando el video no trae subtítulos
# (uploads, o URLs sin captions/auto-captions). Si no se define ninguna,
# el análisis sigue funcionando pero sin transcripción.
GROQ_API_KEY=
OPENAI_API_KEY=

# Opcionales: rutas de almacenamiento local. Por default cuelgan de ./storage
# DATABASE_PATH=./storage/db.sqlite
# WORK_DIR=./storage/frames
# UPLOAD_DIR=./storage/uploads

# Requerida si vas a exponer el dashboard públicamente (ver DEPLOY.md):
# pide esta contraseña (con cualquier usuario) para entrar al dashboard
# entero, incluida la API. Si la dejás vacía, la app queda sin login.
DASHBOARD_PASSWORD=

# Requerida solo para el deploy con Docker Compose + Caddy (ver DEPLOY.md):
# hostname público por el que Caddy va a pedir el certificado HTTPS.
# Ej: la IP pública de tu VM con el truco de sslip.io -> 123.45.67.89.sslip.io
PUBLIC_HOSTNAME=
