{
  "name": "mdracing-intro",
  "version": "1.0.0",
  "description": "Intro animado MDRACING para tutorial de instalacion de fundas (Remotion)",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "render:vertical": "remotion render src/index.ts IntroVertical out/mdracing-intro-vertical.mp4",
    "render:horizontal": "remotion render src/index.ts IntroHorizontal out/mdracing-intro-horizontal.mp4",
    "render:outro-vertical": "remotion render src/index.ts OutroVertical out/mdracing-outro-vertical.mp4",
    "render:outro-horizontal": "remotion render src/index.ts OutroHorizontal out/mdracing-outro-horizontal.mp4",
    "render:intro": "npm run render:vertical && npm run render:horizontal",
    "render:outro": "npm run render:outro-vertical && npm run render:outro-horizontal",
    "render:all": "npm run render:intro && npm run render:outro",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.503",
    "@remotion/google-fonts": "4.0.503",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.503",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
